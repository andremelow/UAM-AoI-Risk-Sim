diff --git a/lib/du/du_high/test_mode/test_mode_traffic_source.cpp b/lib/du/du_high/test_mode/test_mode_traffic_source.cpp
new file mode 100644
index 0000000..fa69633
--- /dev/null
+++ b/lib/du/du_high/test_mode/test_mode_traffic_source.cpp
@@ -0,0 +1,167 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026 OCUDU contributors
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "test_mode_traffic_source.h"
+#include <algorithm>
+
+using namespace ocudu;
+using namespace odu;
+
+/// Bytes of a grant that the MAC subheaders and the BSR MAC CE take.
+static constexpr unsigned MAC_OVERHEAD_BYTES = 8;
+
+/// Period between flushes of the update log.
+static constexpr uint64_t LOG_FLUSH_PERIOD_US = 1000000;
+
+test_mode_traffic_source::test_mode_traffic_source(const du_test_mode_config::traffic_source_config& cfg_,
+                                                   rnti_t                                            first_rnti_,
+                                                   unsigned                                          nof_ues_) :
+  cfg(cfg_),
+  first_rnti(first_rnti_),
+  c2_period_us(std::chrono::duration_cast<std::chrono::microseconds>(cfg_.c2_period).count()),
+  frame_period_us(1000000U / std::max(cfg_.video_fps, 1U)),
+  ues(nof_ues_)
+{
+  if (not cfg.log_file.empty()) {
+    log.open(cfg.log_file);
+    log << "t_us,rnti,source,event,seq,bytes,gen_us\n";
+  }
+}
+
+void test_mode_traffic_source::start_ue(rnti_t rnti)
+{
+  std::lock_guard<std::mutex> lock(mutex);
+  const unsigned              idx = static_cast<unsigned>(rnti) - static_cast<unsigned>(first_rnti);
+  if (idx >= ues.size() or ues[idx].active) {
+    return;
+  }
+  ue_source& u = ues[idx];
+  u            = {};
+  u.active     = true;
+  // The UEs spread their generation instants and their I-frames evenly over a period.
+  u.next_c2_us    = now_us + idx * c2_period_us / ues.size();
+  u.next_frame_us = now_us + idx * frame_period_us / ues.size();
+  u.frame_counter = idx * cfg.video_gop / ues.size();
+}
+
+void test_mode_traffic_source::run_slot(std::chrono::microseconds slot_duration, std::vector<rnti_t>& updated)
+{
+  std::lock_guard<std::mutex> lock(mutex);
+  now_us += slot_duration.count();
+
+  for (unsigned idx = 0, e = ues.size(); idx != e; ++idx) {
+    ue_source& u = ues[idx];
+    if (not u.active) {
+      continue;
+    }
+    const rnti_t rnti      = to_rnti(static_cast<unsigned>(first_rnti) + idx);
+    bool         generated = false;
+
+    while (now_us >= u.next_c2_us) {
+      if (u.c2_rem > 0) {
+        // The new sample replaces the sample that was not delivered.
+        log_event(rnti, "c2", "drop", u.c2_seq, u.c2_rem, u.c2_gen_us);
+      }
+      ++u.c2_seq;
+      u.c2_rem    = cfg.c2_bytes;
+      u.c2_gen_us = u.next_c2_us;
+      u.next_c2_us += c2_period_us;
+      generated = true;
+    }
+
+    while (now_us >= u.next_frame_us) {
+      video_frame frame;
+      frame.valid     = true;
+      frame.is_iframe = u.frame_counter % cfg.video_gop == 0;
+      frame.seq       = u.frame_counter;
+      frame.size      = frame.is_iframe ? cfg.video_i_bytes : cfg.video_p_bytes;
+      frame.rem       = frame.size;
+      frame.gen_us    = u.next_frame_us;
+      ++u.frame_counter;
+      u.next_frame_us += frame_period_us;
+
+      if (not u.in_service.valid) {
+        u.in_service = frame;
+      } else {
+        if (u.pending.valid) {
+          // The new frame replaces the pending frame. The frame in service continues.
+          log_event(rnti, u.pending.is_iframe ? "vI" : "vP", "drop", u.pending.seq, u.pending.rem, u.pending.gen_us);
+        }
+        u.pending = frame;
+      }
+      generated = true;
+    }
+
+    if (generated) {
+      updated.push_back(rnti);
+    }
+  }
+
+  if (log.is_open() and now_us >= next_flush_us) {
+    log.flush();
+    next_flush_us = now_us + LOG_FLUSH_PERIOD_US;
+  }
+}
+
+void test_mode_traffic_source::serve(rnti_t rnti, unsigned tbs_bytes)
+{
+  std::lock_guard<std::mutex> lock(mutex);
+  const unsigned              idx = static_cast<unsigned>(rnti) - static_cast<unsigned>(first_rnti);
+  if (idx >= ues.size() or not ues[idx].active) {
+    return;
+  }
+  ue_source& u     = ues[idx];
+  unsigned   bytes = tbs_bytes > MAC_OVERHEAD_BYTES ? tbs_bytes - MAC_OVERHEAD_BYTES : 0;
+
+  // The C2 logical channel has the highest priority.
+  if (u.c2_rem > 0 and bytes > 0) {
+    const unsigned taken = std::min(bytes, u.c2_rem);
+    u.c2_rem -= taken;
+    bytes -= taken;
+    if (u.c2_rem == 0) {
+      log_event(rnti, "c2", "rx", u.c2_seq, cfg.c2_bytes, u.c2_gen_us);
+    }
+  }
+
+  // The video frames take the remaining bytes in generation order.
+  while (bytes > 0 and u.in_service.valid) {
+    const unsigned taken = std::min(bytes, u.in_service.rem);
+    u.in_service.rem -= taken;
+    bytes -= taken;
+    if (u.in_service.rem == 0) {
+      log_event(rnti,
+                u.in_service.is_iframe ? "vI" : "vP",
+                "rx",
+                u.in_service.seq,
+                u.in_service.size,
+                u.in_service.gen_us);
+      u.in_service = u.pending;
+      u.pending    = {};
+    }
+  }
+}
+
+test_mode_traffic_source::buffer_state test_mode_traffic_source::get_buffer_state(rnti_t rnti)
+{
+  std::lock_guard<std::mutex> lock(mutex);
+  const unsigned              idx = static_cast<unsigned>(rnti) - static_cast<unsigned>(first_rnti);
+  if (idx >= ues.size() or not ues[idx].active) {
+    return {};
+  }
+  const ue_source& u = ues[idx];
+  return {u.c2_rem, (u.in_service.valid ? u.in_service.rem : 0) + (u.pending.valid ? u.pending.rem : 0)};
+}
+
+void test_mode_traffic_source::log_event(rnti_t      rnti,
+                                         const char* source,
+                                         const char* event,
+                                         unsigned    seq,
+                                         unsigned    bytes,
+                                         uint64_t    gen_us)
+{
+  if (not log.is_open()) {
+    return;
+  }
+  log << now_us << ',' << std::hex << static_cast<unsigned>(rnti) << std::dec << ',' << source << ',' << event << ','
+      << seq << ',' << bytes << ',' << gen_us << '\n';
+}

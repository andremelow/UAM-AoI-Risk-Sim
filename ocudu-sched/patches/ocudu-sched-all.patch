+// SPDX-FileCopyrightText: Copyright (C) 2026 OCUDU contributors
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include "scheduler_policy.h"
+#include "scheduler_time_qos.h"
+#include "ocudu/scheduler/config/scheduler_expert_config.h"
+#include "ocudu/scheduler/config/logical_channel_group.h"
+#include <array>
+#include <chrono>
+#include <unordered_map>
+
+namespace ocudu {
+
+class cell_configuration;
+
+/// \brief Risk-aware Max-Weight UL policy.
+///
+/// Each UE holds up to two UL sources, a C2 source on the GBR DRB logical channel group and a video source on the
+/// non-GBR one. The weight of a source is W = V * p * h, where h is the age of the source, p is the channel-gated
+/// success probability of the UE and V = alpha / q_lb. The lower-bound service rate
+/// q_lb = min(K * sqrt(alpha * p_nom) / Theta, p_nom), with Theta = sum_s sqrt(alpha_s / p_nom), is solved every slot
+/// over the sources of the UL candidates that hold data. The UL priority of a UE is the highest weight of its sources.
+///
+/// The age of a source counts the slots since a grant last emptied its buffer. The grant of a UE serves its C2 buffer
+/// first, as the logical channel prioritization of the UE does. A UE without data in either group counts as a single
+/// source whose age restarts at every grant.
+///
+/// An external file provides the risk coefficients of each UE.
+///
+/// DL scheduling is delegated to the QoS-aware policy.
+class scheduler_time_risk final : public scheduler_policy
+{
+public:
+  scheduler_time_risk(const time_risk_scheduler_config& policy_cfg_, const cell_configuration& cell_cfg);
+
+  void add_ue(du_ue_index_t ue_index) override;
+
+  void rem_ue(du_ue_index_t ue_index) override;
+
+  void compute_ue_dl_priorities(slot_point               pdcch_slot,
+                                slot_point               pdsch_slot,
+                                span<ue_newtx_candidate> ue_candidates) override;
+
+  void compute_ue_ul_priorities(slot_point               pdcch_slot,
+                                slot_point               pusch_slot,
+                                span<ue_newtx_candidate> ue_candidates) override;
+
+  void save_dl_newtx_grants(pdu_span<dl_msg_alloc> dl_grants) override;
+
+  void save_ul_newtx_grants(pdu_span<ul_sched_info> ul_grants) override;
+
+private:
+  /// Reloads the risk coefficients from the file when the reload period elapses.
+  void reload_alphas();
+
+  /// UL sources of a UE.
+  enum source_index : unsigned { c2_source = 0, video_source = 1, nof_sources = 2 };
+
+  /// Risk coefficients of a UE.
+  struct ue_alphas {
+    double c2;
+    double video;
+  };
+
+  /// UL state of a UE.
+  struct ue_ul_state {
+    /// PUSCH slot at which a grant last emptied the buffer of each source.
+    std::array<slot_point, nof_sources> last_empty_slot;
+    /// Pending bytes of each source at the last priority computation.
+    std::array<unsigned, nof_sources> pending_bytes{};
+    /// Pending new transmission bytes of the UE at the last priority computation.
+    unsigned newtx_bytes = 0;
+  };
+
+  /// Returns the risk coefficients of the given UE.
+  ue_alphas get_alphas(rnti_t rnti) const;
+
+  /// Returns the age in slots of a source and starts it when the source is new.
+  double get_age(slot_point& last_empty_slot, slot_point pusch_slot) const;
+
+  /// Policy parameters.
+  const time_risk_scheduler_config params;
+
+  /// Policy that schedules the DL.
+  scheduler_time_qos dl_policy;
+
+  /// Rate estimator that provides the UL channel gate.
+  rate_estimator rate_estim;
+
+  /// Risk coefficients of each UE, indexed by C-RNTI.
+  std::unordered_map<unsigned, ue_alphas> alphas;
+
+  /// Time of the last risk coefficient reload.
+  std::chrono::steady_clock::time_point last_reload{};
+
+  /// UL state of each UE.
+  std::array<ue_ul_state, MAX_NOF_DU_UES> ue_states{};
+
+  /// PUSCH slot of the last UL priority computation.
+  slot_point last_pusch_slot;
+};
+
+} // namespace ocudu

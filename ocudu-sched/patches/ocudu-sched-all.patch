+// SPDX-FileCopyrightText: Copyright (C) 2026 OCUDU contributors
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#pragma once
+
+#include "ocudu/du/du_high/du_test_mode_config.h"
+#include "ocudu/ran/rnti.h"
+#include <chrono>
+#include <cstdint>
+#include <fstream>
+#include <mutex>
+#include <vector>
+
+namespace ocudu::odu {
+
+/// \brief Two-source UL traffic model of the test UEs of a cell.
+///
+/// Each UE holds a C2 source and a video source. The C2 source keeps its freshest sample only. The video source keeps
+/// the frame in service and the freshest pending frame, so a new frame replaces a pending one and never interrupts
+/// the frame in service. A served grant drains the C2 sample first and the video frames after it, as the logical
+/// channel prioritization of a UE does.
+class test_mode_traffic_source
+{
+public:
+  /// UL buffer occupancy of a UE, in bytes.
+  struct buffer_state {
+    unsigned c2_bytes    = 0;
+    unsigned video_bytes = 0;
+  };
+
+  test_mode_traffic_source(const du_test_mode_config::traffic_source_config& cfg_,
+                           rnti_t                                            first_rnti_,
+                           unsigned                                          nof_ues_);
+
+  /// Starts the sources of a UE.
+  void start_ue(rnti_t rnti);
+
+  /// \brief Advances the model by one slot and generates the updates that are due.
+  /// \param[in] slot_duration Duration of a slot.
+  /// \param[out] updated UEs that generated an update in this slot.
+  void run_slot(std::chrono::microseconds slot_duration, std::vector<rnti_t>& updated);
+
+  /// Drains the buffers of a UE with a correctly decoded grant of the given transport block size.
+  void serve(rnti_t rnti, unsigned tbs_bytes);
+
+  /// Returns the UL buffer occupancy of a UE.
+  buffer_state get_buffer_state(rnti_t rnti);
+
+private:
+  struct video_frame {
+    bool     valid    = false;
+    bool     is_iframe = false;
+    unsigned seq      = 0;
+    unsigned size     = 0;
+    unsigned rem      = 0;
+    uint64_t gen_us   = 0;
+  };
+
+  struct ue_source {
+    bool        active        = false;
+    uint64_t    next_c2_us    = 0;
+    uint64_t    next_frame_us = 0;
+    unsigned    frame_counter = 0;
+    unsigned    c2_seq        = 0;
+    unsigned    c2_rem        = 0;
+    uint64_t    c2_gen_us     = 0;
+    video_frame in_service;
+    video_frame pending;
+  };
+
+  /// Writes one line of the update log.
+  void log_event(rnti_t rnti, const char* source, const char* event, unsigned seq, unsigned bytes, uint64_t gen_us);
+
+  const du_test_mode_config::traffic_source_config cfg;
+  const rnti_t                                     first_rnti;
+  const uint64_t                                   c2_period_us;
+  const uint64_t                                   frame_period_us;
+
+  std::mutex             mutex;
+  uint64_t               now_us        = 0;
+  uint64_t               next_flush_us = 0;
+  std::vector<ue_source> ues;
+  std::ofstream          log;
+};
+
+} // namespace ocudu::odu

diff --git a/lib/scheduler/policy/scheduler_time_risk.cpp b/lib/scheduler/policy/scheduler_time_risk.cpp
new file mode 100644
index 0000000..6a48593
--- /dev/null
+++ b/lib/scheduler/policy/scheduler_time_risk.cpp
@@ -0,0 +1,167 @@
+// SPDX-FileCopyrightText: Copyright (C) 2026 OCUDU contributors
+// SPDX-License-Identifier: BSD-3-Clause-Open-MPI
+
+#include "scheduler_time_risk.h"
+#include "../slicing/slice_ue_repository.h"
+#include <cmath>
+#include <fstream>
+#include <sstream>
+
+using namespace ocudu;
+
+scheduler_time_risk::scheduler_time_risk(const time_risk_scheduler_config& policy_cfg_,
+                                         const cell_configuration&         cell_cfg) :
+  params(policy_cfg_), dl_policy(time_qos_scheduler_config{}, cell_cfg), rate_estim(cell_cfg)
+{
+}
+
+void scheduler_time_risk::add_ue(du_ue_index_t ue_index)
+{
+  dl_policy.add_ue(ue_index);
+  // The ages of a new UE start at its creation.
+  ue_states[ue_index] = {};
+  ue_states[ue_index].last_empty_slot.fill(last_pusch_slot);
+}
+
+void scheduler_time_risk::rem_ue(du_ue_index_t ue_index)
+{
+  dl_policy.rem_ue(ue_index);
+  ue_states[ue_index] = {};
+}
+
+void scheduler_time_risk::compute_ue_dl_priorities(slot_point               pdcch_slot,
+                                                   slot_point               pdsch_slot,
+                                                   span<ue_newtx_candidate> ue_candidates)
+{
+  dl_policy.compute_ue_dl_priorities(pdcch_slot, pdsch_slot, ue_candidates);
+}
+
+void scheduler_time_risk::compute_ue_ul_priorities(slot_point               pdcch_slot,
+                                                   slot_point               pusch_slot,
+                                                   span<ue_newtx_candidate> ue_candidates)
+{
+  last_pusch_slot = pusch_slot;
+  reload_alphas();
+
+  const double p_nom = params.success_prob;
+
+  // Update the buffers of the sources. A UE without data in the C2 and video groups counts as a single source.
+  double theta = 0.0;
+  for (const ue_newtx_candidate& candidate : ue_candidates) {
+    const slice_ue& u     = *candidate.ue;
+    ue_ul_state&    state = ue_states[u.ue_index()];
+    const ue_alphas alpha = get_alphas(u.crnti());
+
+    state.pending_bytes[c2_source]    = u.pending_ul_unacked_bytes(GBR_DRB_LCG_ID);
+    state.pending_bytes[video_source] = u.pending_ul_unacked_bytes(NON_GBR_DRB_LCG_ID);
+    state.newtx_bytes                 = candidate.pending_bytes.value();
+
+    // The lower bound is solved over the sources of this slot, which makes Theta common to all of them.
+    const bool single_source = state.pending_bytes[c2_source] == 0 and state.pending_bytes[video_source] == 0;
+    if (single_source or state.pending_bytes[c2_source] > 0) {
+      theta += std::sqrt(std::max(alpha.c2, 0.0) / p_nom);
+    }
+    if (state.pending_bytes[video_source] > 0) {
+      theta += std::sqrt(std::max(alpha.video, 0.0) / p_nom);
+    }
+  }
+
+  for (ue_newtx_candidate& candidate : ue_candidates) {
+    const slice_ue& u     = *candidate.ue;
+    ue_ul_state&    state = ue_states[u.ue_index()];
+    const ue_alphas alpha = get_alphas(u.crnti());
+
+    // The channel gate removes the UEs that cannot achieve the minimum transport block size.
+    const unsigned estimated_max_tbs = rate_estim.estimate_max_ul_tbs(u.get_cc());
+    if (estimated_max_tbs == 0 or theta <= 0.0) {
+      candidate.priority = forbid_sched_priority;
+      continue;
+    }
+    const double p_eff = estimated_max_tbs >= params.min_tbs_bytes ? p_nom : 0.0;
+
+    const bool single_source = state.pending_bytes[c2_source] == 0 and state.pending_bytes[video_source] == 0;
+    double     weight        = 0.0;
+    for (unsigned src = 0; src != nof_sources; ++src) {
+      const bool has_data = state.pending_bytes[src] > 0 or (single_source and src == c2_source);
+      // The ages of all the sources advance, so that a source that receives data starts from its real age.
+      const double age_slots    = get_age(state.last_empty_slot[src], pusch_slot);
+      const double source_alpha = src == c2_source ? alpha.c2 : alpha.video;
+      if (not has_data or source_alpha <= 0.0) {
+        continue;
+      }
+      const double q_lb = std::min(params.ues_per_slot * std::sqrt(source_alpha * p_nom) / theta, p_nom);
+      weight            = std::max(weight, source_alpha / q_lb * p_eff * age_slots);
+    }
+
+    // A gated UE keeps the lowest valid priority, which serves it only when no other UE needs the slot.
+    candidate.priority = weight > 0.0 ? weight : lowest_sched_priority;
+  }
+}
+
+void scheduler_time_risk::save_dl_newtx_grants(pdu_span<dl_msg_alloc> dl_grants)
+{
+  dl_policy.save_dl_newtx_grants(dl_grants);
+}
+
+void scheduler_time_risk::save_ul_newtx_grants(pdu_span<ul_sched_info> ul_grants)
+{
+  for (const ul_sched_info& grant : ul_grants) {
+    ue_ul_state&   state     = ue_states[grant.context.ue_index];
+    const unsigned tbs_bytes = grant.pusch_cfg.tb_size_bytes.value();
+
+    const bool single_source = state.pending_bytes[c2_source] == 0 and state.pending_bytes[video_source] == 0;
+    if (single_source or tbs_bytes >= state.newtx_bytes) {
+      // The grant empties all the buffers of the UE.
+      state.last_empty_slot.fill(last_pusch_slot);
+    } else if (state.pending_bytes[c2_source] > 0 and tbs_bytes >= state.pending_bytes[c2_source]) {
+      // The UE serves its C2 buffer first, so the grant empties it and leaves video data behind.
+      state.last_empty_slot[c2_source] = last_pusch_slot;
+    }
+  }
+}
+
+void scheduler_time_risk::reload_alphas()
+{
+  const auto now = std::chrono::steady_clock::now();
+  if (last_reload != std::chrono::steady_clock::time_point{} and now - last_reload < params.alpha_reload_period) {
+    return;
+  }
+  last_reload = now;
+
+  std::ifstream file(params.alpha_file);
+  if (not file.is_open()) {
+    // A missing file keeps the previous coefficients.
+    return;
+  }
+
+  // Each line holds a C-RNTI in hexadecimal, its C2 risk coefficient and, optionally, its video risk coefficient.
+  std::unordered_map<unsigned, ue_alphas> new_alphas;
+  std::string                          line;
+  while (std::getline(file, line)) {
+    std::istringstream iss(line);
+    unsigned           rnti        = 0;
+    double             alpha_c2    = 0.0;
+    double             alpha_video = params.default_alpha_video;
+    if (iss >> std::hex >> rnti >> std::dec >> alpha_c2) {
+      // The risk coefficient of the video source is optional.
+      iss >> alpha_video;
+      new_alphas[rnti] = {alpha_c2, alpha_video};
+    }
+  }
+  alphas = std::move(new_alphas);
+}
+
+scheduler_time_risk::ue_alphas scheduler_time_risk::get_alphas(rnti_t rnti) const
+{
+  const auto it = alphas.find(static_cast<unsigned>(rnti));
+  return it != alphas.end() ? it->second : ue_alphas{params.default_alpha, params.default_alpha_video};
+}
+
+double scheduler_time_risk::get_age(slot_point& last_empty_slot, slot_point pusch_slot) const
+{
+  if (not last_empty_slot.valid()) {
+    last_empty_slot = pusch_slot;
+  }
+  // The age is at least one slot to keep the weight of a fresh source positive.
+  return std::max<int>(pusch_slot - last_empty_slot, 1);
+}

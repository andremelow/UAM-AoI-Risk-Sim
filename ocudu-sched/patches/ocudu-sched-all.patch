+/// Returns the lowest 8-bit Buffer Size index whose level holds the given number of bytes.
+static uint8_t bytes_to_long_bsr_index(unsigned nof_bytes)
+{
+  static constexpr unsigned max_index = 254;
+  if (nof_bytes == 0) {
+    return 0;
+  }
+  unsigned lo = 1;
+  unsigned hi = max_index;
+  while (lo < hi) {
+    const unsigned mid = (lo + hi) / 2;
+    if (buff_size_field_to_bytes(mid, bsr_format::LONG_BSR) >= nof_bytes) {
+      hi = mid;
+    } else {
+      lo = mid + 1;
+    }
+  }
+  return lo;
+}
+
+expected<mac_rx_data_indication> odu::create_test_pdu_with_bsr(du_cell_index_t cell_index,
+                                                               slot_point      sl_rx,
+                                                               rnti_t          test_rnti,
+                                                               harq_id_t       harq_id,
+                                                               unsigned        c2_bytes,
+                                                               unsigned        video_bytes)
+{
+  // - 8-bit R/LCID MAC subheader.
+  // - MAC CE with Long BSR for LCG1 (C2) and LCG2 (video).
+  //
+  // |   |   |   |   |   |   |   |   |
+  // | R | R |         LCID          |  Octet 1
+  // |              L                |  Octet 2
+  // | LCG7 | LCG6 |    ...   | LCG0 |  Octet 3
+  // |     Buffer Size of LCG1       |  Octet 4
+  // |     Buffer Size of LCG2       |  Octet 5
+  auto buf =
+      byte_buffer::create({0x3e, 0x03, 0x06, bytes_to_long_bsr_index(c2_bytes), bytes_to_long_bsr_index(video_bytes)});
+  if (not buf.has_value()) {
+    return make_unexpected(default_error_t{});
+  }
+  return mac_rx_data_indication{
+      sl_rx, cell_index, mac_rx_pdu_list{mac_rx_pdu{test_rnti, harq_id, std::move(buf.value())}}};
+}
+
